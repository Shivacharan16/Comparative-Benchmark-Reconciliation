{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run End-to-End Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run_demo.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run CLI Benchmark (10k Baseline + 2k Delta)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["benchmark", "--initial", "10000", "--delta", "2000"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run CLI Reconcile",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["reconcile"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Generate 100k Parquet",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["generate", "--count", "1000", "--parquet-100k"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
